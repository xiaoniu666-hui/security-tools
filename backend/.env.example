# ==========================================
# 网络安全工具集 - 环境变量配置
# ==========================================
# 复制此文件为 .env 并填入真实配置
# ==========================================

# 应用基础配置
APP_NAME=SecurityTools
APP_ENV=development
APP_PORT=3000
NODE_ENV=development

# JWT配置 - 生产环境请修改为强密钥
JWT_SECRET=your-super-secret-jwt-key-here-must-be-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345
DB_NAME=security_tools

# 安全配置
BCRYPT_ROUNDS=12

# 限流配置
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX=100

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# AI配置 (可选)
OPENAI_API_KEY=
